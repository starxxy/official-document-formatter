{
  "page": {
    "paper_size": "A4",
    "width_mm": 210,
    "height_mm": 297,
    "top_margin_mm": 37,
    "bottom_margin_mm": 35,
    "left_margin_mm": 28,
    "right_margin_mm": 26,
    "header_distance_mm": 15,
    "footer_distance_mm": 15,
    "lines_per_page": 22,
    "chars_per_line": 28
  },
  "fonts": {
    "title": {
      "name": "方正小标宋简体",
      "english_name": "FZXiaoBiaoSong-B05S",
      "size_pt": 22,
      "bold": false,
      "color": "000000"
    },
    "body": {
      "name": "仿宋_GB2312",
      "english_name": "FangSong_GB2312",
      "size_pt": 16,
      "bold": false,
      "color": "000000"
    },
    "heading1": {
      "name": "黑体",
      "english_name": "SimHei",
      "size_pt": 16,
      "bold": false,
      "color": "000000"
    },
    "heading2": {
      "name": "楷体_GB2312",
      "english_name": "KaiTi_GB2312",
      "size_pt": 16,
      "bold": false,
      "color": "000000"
    },
    "heading3": {
      "name": "仿宋_GB2312",
      "english_name": "FangSong_GB2312",
      "size_pt": 16,
      "bold": false,
      "color": "000000"
    },
    "heading4": {
      "name": "仿宋_GB2312",
      "english_name": "FangSong_GB2312",
      "size_pt": 16,
      "bold": false,
      "color": "000000"
    }
  },
  "paragraph": {
    "body": {
      "first_line_indent_chars": 2,
      "line_spacing_pt": 28,
      "line_spacing_rule": "exact",
      "alignment": "left",
      "space_before_pt": 0,
      "space_after_pt": 0
    },
    "title": {
      "first_line_indent_chars": 0,
      "line_spacing_pt": 28,
      "line_spacing_rule": "exact",
      "alignment": "center",
      "space_before_pt": 0,
      "space_after_pt": 0
    },
    "heading1": {
      "first_line_indent_chars": 0,
      "line_spacing_pt": 28,
      "line_spacing_rule": "exact",
      "alignment": "left",
      "space_before_pt": 0,
      "space_after_pt": 0
    },
    "heading2": {
      "first_line_indent_chars": 0,
      "line_spacing_pt": 28,
      "line_spacing_rule": "exact",
      "alignment": "left",
      "space_before_pt": 0,
      "space_after_pt": 0
    },
    "heading3": {
      "first_line_indent_chars": 0,
      "line_spacing_pt": 28,
      "line_spacing_rule": "exact",
      "alignment": "left",
      "space_before_pt": 0,
      "space_after_pt": 0
    },
    "heading4": {
      "first_line_indent_chars": 0,
      "line_spacing_pt": 28,
      "line_spacing_rule": "exact",
      "alignment": "left",
      "space_before_pt": 0,
      "space_after_pt": 0
    }
  },
  "title_detection": {
    "large_font_pt": 22,
    "main_title_max_length": 60,
    "first_paragraph_as_title": true,
    "centered_title_max_position": 5
  },
  "title_patterns": {
    "level1": {
      "pattern": "^[一二三四五六七八九十]+、",
      "description": "一级标题：一、二、三、"
    },
    "level2": {
      "pattern": "^（[一二三四五六七八九十]+）",
      "description": "二级标题：（一）（二）（三）"
    },
    "level3": {
      "pattern": "^\\d+\\.",
      "description": "三级标题：1. 2. 3."
    },
    "level4": {
      "pattern": "^（\\d+）",
      "description": "四级标题：（1）（2）（3）"
    }
  },
  "required_fonts": {
    "方正小标宋简体": {
      "name": "方正小标宋简体",
      "family_names": ["方正小标宋简体", "FZXiaoBiaoSong-B05S"],
      "bundled_filename": "方正小标宋简体.ttf",
      "target_filename": "方正小标宋简体.ttf",
      "sources": [
        {
          "name": "河南工业大学",
          "url": "https://www.haut.edu.cn/info/1128/28360.htm"
        },
        {
          "name": "新乡医学院",
          "url": "https://www.xxmu.edu.cn/lifescience/info/1102/2765.htm"
        }
      ]
    },
    "仿宋_GB2312": {
      "name": "仿宋_GB2312",
      "family_names": ["仿宋_GB2312", "FangSong_GB2312"],
      "bundled_filename": "仿宋_GB2312.ttf",
      "target_filename": "仿宋_GB2312.ttf",
      "sources": [
        {
          "name": "河南工业大学",
          "url": "https://www.haut.edu.cn/info/1128/28360.htm"
        },
        {
          "name": "新乡医学院",
          "url": "https://www.xxmu.edu.cn/lifescience/info/1102/2765.htm"
        }
      ]
    },
    "楷体_GB2312": {
      "name": "楷体_GB2312",
      "family_names": ["楷体_GB2312", "KaiTi_GB2312"],
      "bundled_filename": "楷体_GB2312.ttf",
      "target_filename": "楷体_GB2312.ttf",
      "sources": [
        {
          "name": "河南工业大学",
          "url": "https://www.haut.edu.cn/info/1128/28360.htm"
        },
        {
          "name": "新乡医学院",
          "url": "https://www.xxmu.edu.cn/lifescience/info/1102/2765.htm"
        }
      ]
    }
  },
  "output_options": {
    "default_mode": "create_new",
    "modes": {
      "overwrite": "覆盖原文档",
      "create_new": "创建新文档（文件名后缀_formatted）",
      "ask_user": "询问用户"
    }
  },
  "error_handling": {
    "batch_mode": "skip_and_continue",
    "modes": {
      "skip_and_continue": "跳过错误文档，继续处理其他文档",
      "stop_immediately": "遇到错误立即停止",
      "ask_user": "询问用户是否继续"
    }
  }
}
